APP_NAME="Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must be the real public URL in production: Stripe and Mollie build their
# webhook and return URLs from it, so a wrong value silently breaks payment.
APP_URL=http://shop.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The order email is queued, so production needs a worker running or customers
# never receive their download links. See the deploy notes in README.md.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log is fine locally; production needs a real transport or no order mail goes out.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Download links. TTL is how long an emailed link stays valid; max uses is how
# often one link may be used. Either at 0 turns that limit off.
SHOP_DOWNLOAD_LINK_TTL_DAYS=14
SHOP_DOWNLOAD_MAX_USES=10

# Payment credentials. These are the fallback: anything set at /admin/settings is
# stored encrypted in the database and wins over the values here.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
MOLLIE_KEY=

# Error reporting to flare. Off by default: a fresh clone has no project
# registered in flare yet, and enabling it without a key would have every clone
# firing at the ingest endpoint with nothing to accept it. Register the app in
# flare, put its key here, then flip FLARE_ENABLED to true and confirm with
# `php artisan flare:test`.
FLARE_ENABLED=false
FLARE_URL=https://flare.thijssensoftware.nl
FLARE_KEY=
